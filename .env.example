# ---------- Application ----------
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8787
FRONTEND_URL=http://localhost:5173

# ---------- Tavily (REQUIRED) - https://app.tavily.com ----------
TAVILY_API_KEY=

# ---------- FREE LLM option (recommended if you have no paid key) ----------
# Any OpenAI-compatible provider. Examples (check each provider's current docs/free limits):
#  Gemini  : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash   (key: https://aistudio.google.com/apikey)
#  Groq    : LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile              (key: https://console.groq.com)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---------- Anthropic (optional, paid) ----------
# (REQUIRED only if you use Anthropic; leave empty otherwise) - https://console.anthropic.com ----------
ANTHROPIC_API_KEY=

# ---------- Fallback provider (optional): openai | anthropic ----------
FALLBACK_PROVIDER=
FALLBACK_API_KEY=
FALLBACK_MODEL=

# ---------- Bifrost gateway (self-hosted, https://docs.getbifrost.ai) ----------
BIFROST_ENABLED=false
BIFROST_BASE_URL=http://localhost:8080
BIFROST_API_KEY=
BIFROST_MAX_RETRIES=1

# ---------- Models (verify IDs against provider docs) ----------
# Leave MODEL_* empty to use LLM_MODEL for every task
MODEL_ENTITY_RESOLUTION=
MODEL_QUERY_PLANNING=
MODEL_CLAIM_EXTRACTION=
MODEL_SEMANTIC_VERIFICATION=
MODEL_SYNTHESIS=
MODEL_QUESTION_GENERATION=

# ---------- Research limits ----------
MAX_TAVILY_CREDITS_PER_BRIEF=30
MAX_GAP_ROUNDS=2
MAX_RESEARCH_SECONDS=60
MAX_ATTENDEES=3

# ---------- Security / rate limiting ----------
RATE_LIMIT_ENABLED=true
MAX_REQUEST_SIZE=32kb
DAILY_CREDIT_LIMIT=600
